@JobTracker_Api_HostAddress = http://localhost:5080
@JobId = 00000000-0000-0000-0000-000000000000

GET {{JobTracker_Api_HostAddress}}/api/jobs
Accept: application/json

###

POST {{JobTracker_Api_HostAddress}}/api/jobs
Content-Type: application/json

{
  "userId": "c86e2881-b341-4eef-845c-9f826c0d0307",
  "jobUrl": "https://example.no/jobs/123",
  "title": "Senior Software Engineer",
  "company": "Example AS",
  "description": "Build reliable services using C# and PostgreSQL.",
  "location": "Oslo"
}

###

PUT {{JobTracker_Api_HostAddress}}/api/jobs/{{JobId}}/status
Content-Type: application/json

{
  "status": "Interviewing"
}

###

DELETE {{JobTracker_Api_HostAddress}}/api/jobs/{{JobId}}

